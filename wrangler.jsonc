{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "iphone-photo-dashboard",
  "main": "./src/index.js",
  "compatibility_date": "2026-08-18",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "SHORTCUT_NAME": "Photo Dashboard Capture",
    "MAX_UPLOAD_BYTES": "8388608"
  },
  "kv_namespaces": [
    {
      "binding": "PHOTO_STATE",
      "id": "REPLACE_WITH_KV_NAMESPACE_ID"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PHOTO_BUCKET",
      "bucket_name": "iphone-photo-dashboard"
    }
  ]
}
